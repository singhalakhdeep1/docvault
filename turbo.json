{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**"
            ]
        },
        "dev": {
            "cache": false
        },
        "lint": {
            "outputs": []
        },
        "type-check": {
            "outputs": []
        },
        "test": {
            "outputs": []
        },
        "test:e2e": {
            "outputs": []
        }
    }
}